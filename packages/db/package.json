{
  "name": "@playa-hoy/db",
  "version": "0.0.0",
  "private": true,
  "description": "Esquema de Drizzle, migraciones y consultas a PostgreSQL con PostGIS",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./pruebas": "./src/pruebas.ts"
  },
  "scripts": {
    "drizzle-kit": "node --env-file-if-exists=../../.env node_modules/drizzle-kit/bin.cjs",
    "migrate": "node --env-file-if-exists=../../.env src/migrar.ts",
    "seed": "node --env-file-if-exists=../../.env src/seed.ts",
    "studio": "node --env-file-if-exists=../../.env node_modules/drizzle-kit/bin.cjs studio",
    "typecheck": "tsc -p ."
  },
  "dependencies": {
    "@playa-hoy/shared": "workspace:*",
    "drizzle-orm": "0.45.4",
    "postgres": "3.4.9"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "drizzle-kit": "0.31.11"
  }
}
