# Copia este fichero como .env y rellena los valores. El .env no se sube al repositorio.
# Cada app valida al arrancar solo las variables que usa (packages/shared/src/entorno.ts).

# PostgreSQL con PostGIS. En local, la base de datos de compose.yaml (pnpm db:up).
# En producción, la cadena de conexión de Neon, sin "&channel_binding=require" (el driver
# postgres no lo admite) y mejor la directa, sin "-pooler" en el host.
DATABASE_URL=postgresql://playa:playa@localhost:5435/playahoy

# Clave de AEMET OpenData, gratuita: https://opendata.aemet.es/centrodedescargas/altaUsuario
AEMET_API_KEY=

# Opcional. Límite de peticiones por IP de la API, con Upstash Redis (plan gratuito):
# https://console.upstash.com, base de datos Redis, pestaña REST API. Sin ellas, la API no
# limita (desarrollo y tests). En Vercel hacen falta las dos.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Opcional. Puerto de la API en local (3001 por defecto).
# PORT=3001

# Opcional. Puerto de la base de datos local de compose.yaml (5435 por defecto).
# DB_PORT=5435
