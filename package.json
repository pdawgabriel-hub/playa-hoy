{
  "name": "playa-hoy",
  "version": "0.0.0",
  "private": true,
  "description": "Recomendador de playas de la Región de Murcia según viento, oleaje, orientación y plan",
  "license": "MIT",
  "author": "Gabriel Iborra Vicente",
  "type": "module",
  "scripts": {
    "dev:web": "pnpm --filter @playa-hoy/web dev",
    "dev:api": "pnpm --filter @playa-hoy/api dev",
    "lint": "oxlint --type-aware --deny-warnings --no-error-on-unmatched-pattern && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:up": "docker compose up -d --wait db",
    "db:stop": "docker compose stop db",
    "db:psql": "docker compose exec db psql -U playa -d playahoy",
    "db:migrate": "pnpm --filter @playa-hoy/db migrate",
    "db:seed": "pnpm --filter @playa-hoy/db seed",
    "db:studio": "pnpm --filter @playa-hoy/db studio"
  },
  "engines": {
    "node": ">=24.22"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.15.0",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@12.15.0",
  "devDependencies": {
    "oxlint": "1.89.0",
    "oxlint-tsgolint": "7.0.2004",
    "prettier": "3.9.10",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}
